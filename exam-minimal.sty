% --------------------------------------------------------------

\NeedsTeXFormat{LaTeX2e}[2022-06-01]
\ProvidesPackage{exam-minimal}[2026/11/07 v2.0 Minimal exam package]

\RequirePackage{sagar-base}

% If you already loaded the full packages yourself, keep them as they are
% (re-loading with different options would be an "Option clash").
\@ifpackageloaded{sagar-graphics-tikz-core}{}%
  {\RequirePackage[noplots]{sagar-graphics-tikz-core}}   % TikZ + tkz-euclide, no pgfplots
\@ifpackageloaded{sagar-exam-core}{}%
  {\RequirePackage[lean]{sagar-exam-core}}               % exam.cls labels/marks only

\endinput
