\NeedsTeXFormat{LaTeX2e}[2022-06-01]
\ProvidesPackage{sagar-graphics-extended}[2026/11/07 v2.0 Extended graphics]

\RequirePackage{sagar-graphics-tikz-core}   % (v1.0 asked for a non-existent "sagar-graphics-core")
\RequirePackage{siunitx}[2022/01/01]        % circuitikz labels use \SI-style units
\RequirePackage[americanvoltages,fulldiodes,siunitx]{circuitikz}

\usetikzlibrary{
  shadows.blur,               % drop shadows / blur
  math,                       % maths inside TikZ
  decorations.pathmorphing,   % wavy lines, zigzag
  backgrounds,                % background layers
  fit                         % fit nodes around content
}
% (legacy "arrows" library dropped: superseded by arrows.meta in core)

\@ifpackageloaded{pgfplots}{\usepgfplotslibrary{statistics}}{}  % box plots, histograms

\endinput
