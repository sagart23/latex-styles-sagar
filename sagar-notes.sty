% sagar-notes.sty
% Notes layout: headers/footers, section styling, teacher/student flags
% Copyright (c) 2025-2026 Sagar Tamhankar
% MIT License -- see LICENSE file in repository
%
% Options:  student (default)  hide hints, answers and teacher-only text
%           teacher            show everything
% Works with the sagar-notes CLASS or with plain `article`.
% hyperref is NOT loaded here (the class does it); if you use this with
% `article`, load hyperref yourself AFTER this file.
% ============================================================

\NeedsTeXFormat{LaTeX2e}[2022-06-01]
\ProvidesPackage{sagar-notes}[2026/11/07 v2.0 Notes layout + flags]

\RequirePackage{sagar-base}
\RequirePackage{sagar-boxes}
\RequirePackage{etoolbox}
\RequirePackage{enumitem}
\RequirePackage{fancyhdr}
\RequirePackage{lastpage}
\RequirePackage{titlesec}      % replaces obsolete sectsty

% ============================================================
% SCHOOL / DEPARTMENT CONFIG  \setupschool{name}{short}{department}
% ============================================================
\newcommand{\schoolname}{The Cathedral \& John Connon School}
\newcommand{\schoolshort}{CAJCS}
\newcommand{\departmentname}{Mathematics Department}

\newcommand{\setupschool}[3]{%
  \renewcommand{\schoolname}{#1}%
  \renewcommand{\schoolshort}{#2}%
  \renewcommand{\departmentname}{#3}%
}

% ============================================================
% HEADER & FOOTER
% ============================================================
\@ifpackageloaded{geometry}{}{\setlength{\headheight}{25pt}}
\pagestyle{fancy}
\fancyhf{}

\newcommand{\sagar@footers}{%
  \if@twoside
    \fancyfoot[LE,RO]{\sffamily\bfseries Page \thepage\ of \pageref{LastPage}}%
    \fancyfoot[LO,RE]{\sffamily\small \departmentname}%
  \else
    \fancyfoot[R]{\sffamily\bfseries Page \thepage\ of \pageref{LastPage}}%
    \fancyfoot[L]{\sffamily\small \departmentname}%
  \fi
}
\if@twoside
  \fancyhead[LE,RO]{\sffamily\bfseries\color{primaryblue}\leftmark}  % was \rightmark on odd pages = always empty
  \fancyhead[LO,RE]{\sffamily\small \schoolname}
\else
  \fancyhead[R]{\sffamily\bfseries\color{primaryblue}\leftmark}
  \fancyhead[L]{\sffamily\small \schoolname}
\fi
\sagar@footers

\renewcommand{\headrulewidth}{0.5pt}
\renewcommand{\headrule}{%
  \hbox to\headwidth{\color{primaryblue}\leaders\hrule height \headrulewidth\hfill}}

\renewcommand{\sectionmark}[1]{\markboth{#1}{}}

% Title page (\maketitle) and other "plain" pages keep the same footer, no header
\fancypagestyle{plain}{%
  \fancyhf{}%
  \renewcommand{\headrulewidth}{0pt}%
  \sagar@footers
}

% ============================================================
% SECTION STYLING  (same spacing as article; old \sectionfont etc. still work)
% ============================================================
\titleformat{\section}
  {\sffamily\Large\bfseries\color{primaryblue}}{\thesection}{1em}{}
\titleformat{\subsection}
  {\sffamily\large\bfseries\color{secondarygreen!80!black}}{\thesubsection}{1em}{}
\titleformat{\subsubsection}
  {\sffamily\normalsize\bfseries\color{gray!70!black}}{\thesubsubsection}{1em}{}
\titlespacing*{\section}{0pt}{3.5ex plus 1ex minus .2ex}{2.3ex plus .2ex}
\titlespacing*{\subsection}{0pt}{3.25ex plus 1ex minus .2ex}{1.5ex plus .2ex}
\titlespacing*{\subsubsection}{0pt}{3.25ex plus 1ex minus .2ex}{1.5ex plus .2ex}

% sectsty-compatible commands for documents written for v1.x
\newcommand{\sectionfont}[1]{\titleformat{\section}{#1}{\thesection}{1em}{}}
\newcommand{\subsectionfont}[1]{\titleformat{\subsection}{#1}{\thesubsection}{1em}{}}
\newcommand{\subsubsectionfont}[1]{\titleformat{\subsubsection}{#1}{\thesubsubsection}{1em}{}}

% ============================================================
% FLAGS: teacher / hint / answer
% ============================================================
\newif\ifteacher
\newif\ifhint
\newif\ifanswer

\newcommand{\teachermode}{\teachertrue\hinttrue\answertrue}
\newcommand{\studentmode}{\teacherfalse\hintfalse\answerfalse}

\newcommand{\teacheronly}[1]{\ifteacher #1\fi}
\newcommand{\hintonly}[1]{\ifboolexpr{bool{teacher} or bool{hint}}{#1}{}}
\newcommand{\answeronly}[1]{\ifboolexpr{bool{teacher} or bool{answer}}{#1}{}}

% Short aliases
\newcommand{\trs}[1]{\teacheronly{#1}}
\newcommand{\hint}[1]{\hintonly{\begin{hintbox}#1\end{hintbox}}}
\newcommand{\ans}[1]{\answeronly{\begin{Answer}#1\end{Answer}}}

% Package options (student is the default)
\studentmode
\DeclareOption{teacher}{\teachermode}
\DeclareOption{student}{\studentmode}
\ProcessOptions\relax

\endinput
