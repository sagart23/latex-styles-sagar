%
% Option:  todos   show \todo{...} margin notes (default: hidden)
% -------------------------------------------------------

\NeedsTeXFormat{LaTeX2e}[2022-06-01]
\ProvidesPackage{sagar-article-core}[2026/11/07 v2.0 Sagar article/notes core style]

\def\sagar@todoopt{disable}
\DeclareOption{todos}{\def\sagar@todoopt{}}
\ProcessOptions\relax

\RequirePackage{sagar-base}      % fonts, microtype, setspace, tables, multicol, \rupee

% -------------------------------------------------------
% Typography & spacing
% -------------------------------------------------------
\ifPDFTeX        % tracking/kerning are pdfTeX-only microtype features
  \microtypesetup{tracking=true, kerning=true}
\fi
\RequirePackage{parskip}
\setstretch{1.2}                 % comfortable line spacing for reading notes
\setlength{\parskip}{0.6em}
\setlength{\parindent}{0pt}
\raggedbottom                    % flexible page breaks for notes

% -------------------------------------------------------
% Page layout (notes/article profile)
% Use \geometry{...} in your document to change it
% (a second \usepackage[...]{geometry} would be an option clash)
% -------------------------------------------------------
\RequirePackage{geometry}
\geometry{
  left           = 2.5cm,
  right          = 2.5cm,
  top            = 3cm,
  bottom         = 3cm,
  headheight     = 25pt,         % was 15pt: fancyhdr warned it was too small
  headsep        = 1cm,
  footskip       = 1cm,
  marginparwidth = 2cm,
  marginparsep   = 0.5cm
}

% -------------------------------------------------------
% Utilities
% -------------------------------------------------------
\RequirePackage[\sagar@todoopt]{todonotes} % \todo{...}
\RequirePackage{qrcode}                    % \qrcode[height=...]{URL}
\RequirePackage{comment}                   % \begin{comment} ... \end{comment}

% Headers/footers (fancyhdr) -> sagar-notes.sty or your own preamble.
% hyperref is configured per document (or by the sagar-notes class).
\endinput
