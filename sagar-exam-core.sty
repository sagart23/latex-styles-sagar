% sagar-exam-core.sty
% Common exam layout and exam.cls label/point formatting
% for Sagar's ICSE/ISC exams and class tests
% Copyright (c) 2025-2026 Sagar Tamhankar
% MIT License -- see LICENSE file in repository
% Repository: https://github.com/sagart23/latex-styles-sagar.git
%
% Option:  lean   only the exam.cls formatting -- no geometry, no tcolorbox
%                 (this is what exam-minimal uses)
% --------------------------------------------------

\NeedsTeXFormat{LaTeX2e}[2022-06-01]
\ProvidesPackage{sagar-exam-core}[2026/11/07 v2.0 Sagar exam core style]

\newif\ifsagar@lean
\DeclareOption{lean}{\sagar@leantrue}
\ProcessOptions\relax

\RequirePackage{sagar-base}      % fonts, microtype, setspace, tables, multicol, \rupee

\ifsagar@lean\else
  \RequirePackage{geometry}
  \geometry{
    left       = 2cm,
    right      = 2cm,
    top        = 2.5cm,
    bottom     = 2.5cm,
    headheight = 25pt,
    headsep    = 0.8cm,
    footskip   = 0.8cm
  }
  \RequirePackage[most,breakable]{tcolorbox}   % boxes for sagar-exam-extended
\fi

% --------------------------------------------------
% exam.cls customisations (only when the exam class is in use)
% --------------------------------------------------
\@ifclassloaded{exam}{%
  \renewcommand{\questionlabel}{\sffamily\bfseries Q.\thequestion}
  \renewcommand{\partlabel}{\sffamily\bfseries(\thepartno)}
  \renewcommand{\subpartlabel}{\sffamily\bfseries\thesubpart.}

  \pointsdroppedatright
  \marksnotpoints
  \pointformat{\sffamily\bfseries[\themarginpoints]}
  \setlength{\rightpointsmargin}{2.5cm}
}{}

% Watermarks, headers and footers stay in the document preamble.
\endinput
