\NeedsTeXFormat{LaTeX2e}[2022-06-01]
\ProvidesPackage{sagar-math}[2026/11/07 v2.0 Sagar common math package]

\newif\ifsagar@derivs
\DeclareOption{derivs}{\sagar@derivstrue}   % lightweight \dv \ddv \pdv
\ProcessOptions\relax

\RequirePackage{sagar-base}      % fonts, colours, tables, multicol, \rupee

% ------------------------------------------------------
% AMS math
% ------------------------------------------------------
\RequirePackage{amsmath}         % core enhanced math
\RequirePackage{amssymb}         % extra symbols (also loads amsfonts)
\RequirePackage{mathtools}       % fixes & extensions to amsmath

% ------------------------------------------------------
% SI units and number formatting (siunitx v3)
% ------------------------------------------------------
\RequirePackage{siunitx}[2022/01/01]
\sisetup{
  % modern replacement of the deprecated "detect-all"
  mode                    = match,
  propagate-math-font     = true,
  reset-math-version      = false,
  reset-text-family       = false,
  reset-text-series       = false,
  reset-text-shape        = false,
  text-family-to-math     = true,
  text-series-to-math     = true,
  output-decimal-marker   = {.},
}

% ------------------------------------------------------
% Custom math commands
% ------------------------------------------------------
\providecommand{\bvec}[1]{\mathbf{#1}}           % bold vectors
\ifdefined\cosec\else
  \DeclareMathOperator{\cosec}{cosec}            % cosecant (Indian curriculum)
\fi

\ifsagar@derivs
  \providecommand{\dv}[2]{\frac{\mathrm{d}#1}{\mathrm{d}#2}}
  \providecommand{\ddv}[2]{\frac{\mathrm{d}^{2}#1}{\mathrm{d}#2^{2}}}
  \providecommand{\pdv}[2]{\frac{\partial#1}{\partial#2}}
\fi

\endinput
