% sagar-base.sty
% Shared foundation for ALL Sagar style files: fonts, typography,
% colour palette, graphics, table + multi-column tools, rupee symbol.
% Every other sagar-*.sty loads this first, so nothing is duplicated.
% Copyright (c) 2025-2026 Sagar Tamhankar
% MIT License -- see LICENSE file in repository
% Repository: https://github.com/sagart23/latex-styles-sagar.git
% ------------------------------------------------------------------

\NeedsTeXFormat{LaTeX2e}[2022-06-01]
\ProvidesPackage{sagar-base}[2026/11/08 v2.1 Sagar base: fonts, colours, tables, multicol, lists, rupee]

% ------------------------------------------------------------------
% Engine-aware fonts (pdfLaTeX: Latin Modern; Xe/LuaLaTeX: fontspec,
% whose default font is already Latin Modern)
% ------------------------------------------------------------------
\RequirePackage{iftex}
\ifPDFTeX
  \RequirePackage[T1]{fontenc}
  \RequirePackage{lmodern}
\else
  \RequirePackage{fontspec}
\fi

% ------------------------------------------------------------------
% Typography
% ------------------------------------------------------------------
\RequirePackage[final]{microtype}
\ifXeTeX
  \microtypesetup{protrusion=true}
\else
  \microtypesetup{protrusion=true, expansion=true}
\fi
\UseMicrotypeSet[protrusion]{basicmath}
\RequirePackage{setspace}          % \doublespacing, \onehalfspacing, \setstretch
\RequirePackage{enumitem}          % \begin{itemize}[leftmargin=0pt, itemsep=0.3em]

% ------------------------------------------------------------------
% Colour palette -- single source of truth.
% Override in your document with \definecolor{primaryblue}{...}
% ------------------------------------------------------------------
\PassOptionsToPackage{table}{xcolor}   % enables \rowcolors as well as \rowcolor
\RequirePackage{xcolor}
\definecolor{primaryblue}{RGB}{0,102,153}
\definecolor{secondarygreen}{RGB}{51,153,102}
\definecolor{accentorange}{RGB}{255,153,51}
\definecolor{warningred}{RGB}{204,51,51}
\definecolor{backgroundgray}{RGB}{248,249,250}

% ------------------------------------------------------------------
% Graphics
% ------------------------------------------------------------------
\RequirePackage{graphicx}

% ------------------------------------------------------------------
% Tables and multi-column / multi-row layout
%   multicol  -> \begin{multicols}{n} ... \end{multicols}  (text columns)
%   multirow  -> \multirow{rows}{width}{text}              (table cells)
%   \multicolumn is built into LaTeX tables; nothing to load for it.
% ------------------------------------------------------------------
\RequirePackage{multicol}
\RequirePackage{array}
\RequirePackage{booktabs}
\RequirePackage{tabularx}
\RequirePackage{multirow}
\RequirePackage{makecell}
\RequirePackage{colortbl}
\RequirePackage{longtable}
\newcolumntype{Y}{>{\centering\arraybackslash}X}   % centred tabularx column

% ------------------------------------------------------------------
% Indian Rupee symbol:  \rupee
% Uses tfrupee when installed; otherwise warns and falls back to "Rs."
% ------------------------------------------------------------------
\IfFileExists{tfrupee.sty}
  {\RequirePackage{tfrupee}}
  {\PackageWarningNoLine{sagar-base}{%
     Package tfrupee not found; \string\rupee\space will print "Rs." instead}%
   \providecommand{\rupee}{\textup{Rs.}\nobreak\hspace{0.1em}}}

\endinput
