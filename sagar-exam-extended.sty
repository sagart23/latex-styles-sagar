\NeedsTeXFormat{LaTeX2e}[2022-06-01]
\ProvidesPackage{sagar-exam-extended}[2026/11/07 v2.0 Sagar exam extended features]

\RequirePackage{sagar-exam-core}   % geometry, exam labels, tcolorbox
\RequirePackage{sagar-boxes}       % (kept so old exams that rely on it keep working)

\definecolor{examblue}{RGB}{0,70,140}
\definecolor{headerblue}{RGB}{0,90,160}

% Shared exam frame: rounded, padded.  {colour}{frame width}{padding}
\tcbset{
  sagar exam frame/.style n args={3}{
    enhanced, arc=2mm, colframe=#1, boxrule=#2,
    left=#3, right=#3, top=#3, bottom=#3,
  },
}

% --------------------------------------------------
% Exam header box
% --------------------------------------------------
\NewTColorBox{examheaderbox}{}{
  sagar exam frame={examblue}{2pt}{1em},
  colback=white, arc=3mm, drop shadow={black!50!white}, fontupper=\sffamily,
}

% --------------------------------------------------
% Instructions box
% --------------------------------------------------
\NewTColorBox{instructionsbox}{}{
  sagar exam frame={headerblue}{1.5pt}{1em},
  colback=backgroundgray!30, colbacktitle=headerblue, coltitle=white,
  title={\sffamily\bfseries Instructions}, fonttitle=\sffamily\bfseries\large,
  attach boxed title to top center={yshift=-3mm},
  boxed title style={enhanced, size=small, colframe=headerblue, arc=2mm},
  drop shadow={black!20!white}, breakable, top=1.5em,
}

% --------------------------------------------------
% Section header box:  \begin{sectionbox}{A}{Subtitle} ... \end{sectionbox}
% --------------------------------------------------
\NewTColorBox{sectionbox}{m m}{
  sagar exam frame={primaryblue!80!black}{1pt}{1em},
  colback=primaryblue!10, colbacktitle=primaryblue!80!black, coltitle=white,
  title={\sffamily\bfseries\large SECTION #1}, fonttitle=\sffamily\bfseries\large,
  subtitle style={fontupper=\sffamily\itshape, colback=primaryblue!5},
  center title, drop shadow={black!20!white},
  top=0.8em, bottom=0.8em,
  after title={\\\normalsize\itshape #2},
}

% --------------------------------------------------
% Question content box (light grey outline, may break across pages)
% --------------------------------------------------
\NewTColorBox{questionbox}{}{
  sagar exam frame={gray!40}{1pt}{1em},
  arc=1mm, frame hidden, breakable, opacityback=0,
  overlay={\draw[line width=1pt, gray!40, rounded corners=1mm]
             (frame.north west) rectangle (frame.south east);},
}

% --------------------------------------------------
% Grade table box
% --------------------------------------------------
\NewTColorBox{gradetablebox}{}{
  sagar exam frame={examblue}{1pt}{0.5em},
  colback=backgroundgray!20, center upper,
}

% --------------------------------------------------
% \sectionheader{A}{Attempt all questions}
% --------------------------------------------------
\newcommand{\sectionheader}[2]{%
  \begin{sectionbox}{#1}{#2}\end{sectionbox}%
  \vspace{1em}%
}

\endinput
