%
% v2.0: every box is now ONE line built from a shared style.
%   Environment names, arguments and look are unchanged from v1.x.
%   Make your own:   \NewSagarBox{tipbox}{secondarygreen}{5}{70}{Tip}
% -----------------------------------------------------------

\NeedsTeXFormat{LaTeX2e}[2022-06-01]
\ProvidesPackage{sagar-boxes}[2026/11/07 v2.0 Sagar tcolorbox styles]

\RequirePackage{sagar-base}                % colour palette lives there
\RequirePackage[most,breakable]{tcolorbox} % "most" already includes skins, raster, theorems

% -----------------------------------------------------------
% Shared look.  Arguments: {colour}{background %}{frame darkness %}
%   sagar box plain  = no drop shadow
%   sagar box        = with drop shadow (default look)
% Usable on any tcolorbox:  \begin{tcolorbox}[sagar box={accentorange}{10}{80}]
% -----------------------------------------------------------
\tcbset{
  sagar box plain/.style n args={3}{
    enhanced, breakable, sharp corners,
    colback      = #1!#2,
    colframe     = #1!#3!black,
    colbacktitle = #1!#3!black,
    coltitle     = white,
    fonttitle    = \sffamily\bfseries,
    attach boxed title to top left = {xshift=0.5cm, yshift=-3mm, yshifttext=-1mm},
    boxed title style = {enhanced, size=small, sharp corners, colframe=#1!#3!black},
  },
  sagar box/.style n args={3}{
    sagar box plain={#1}{#2}{#3},
    drop shadow = {black!20!white},
  },
}

% -----------------------------------------------------------
% Box factories
%   \NewSagarBox      [extra keys]{env}{colour}{bg%}{frame%}{Fixed title}
%       \begin{env}[tcolorbox keys] ... \end{env}
%   \NewSagarTitledBox[extra keys]{env}{colour}{bg%}{frame%}{Label}
%       \begin{env}[tcolorbox keys]{Your title} ... \end{env}   -> "Label: Your title"
% -----------------------------------------------------------
\NewDocumentCommand{\NewSagarBox}{O{} m m m m m}{%
  \NewTColorBox{#2}{O{}}{sagar box={#3}{#4}{#5}, title={#6}, #1, ##1}%
}
\NewDocumentCommand{\NewSagarTitledBox}{O{} m m m m m}{%
  \NewTColorBox{#2}{O{} m}{sagar box={#3}{#4}{#5}, title={#6: ##2}, #1, ##1}%
}

% -----------------------------------------------------------
% The boxes  (names kept exactly as in v1.x)
% -----------------------------------------------------------
\NewSagarTitledBox{definition}{primaryblue}{5}{80}{Definition}
\NewSagarTitledBox{theorem}{secondarygreen}{5}{80}{Theorem}
\NewSagarTitledBox[colback=backgroundgray, no shadow]{example}{gray}{0}{60}{Example}

\NewSagarBox{noteBox}{accentorange}{10}{80}{Note}
\NewSagarBox[colbacktitle=accentorange!80!black]{hintbox}{primaryblue}{10}{80}{Hint}
\NewSagarBox{important}{warningred}{10}{80}{Important}
\NewSagarBox{errorbox}{warningred}{5}{70}{Common Error}
\NewSagarBox{Mysolutionbox}{secondarygreen}{5}{70}{Solution}
\NewSagarBox{Answer}{secondarygreen}{5}{70}{Answer}
\NewSagarBox{teachingtip}{accentorange}{5}{70}{Teaching Tip}

% -----------------------------------------------------------
% Inline highlight commands
% -----------------------------------------------------------
\newcommand{\highlight}[1]{\textcolor{primaryblue}{\textbf{#1}}}
\newcommand{\emphred}[1]{\textcolor{warningred!80!black}{\textbf{#1}}}
\newcommand{\emphblue}[1]{\textcolor{primaryblue!80!black}{\textbf{#1}}}
\newcommand{\emphgreen}[1]{\textcolor{secondarygreen!80!black}{\textbf{#1}}}
\newcommand{\mistake}[1]{\textcolor{warningred}{\textbf{ERROR: #1}}}
\newcommand{\correct}[1]{\textcolor{secondarygreen}{\textbf{CORRECT: #1}}}

\endinput
